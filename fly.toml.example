# After `fly launch` (it generates most of this), make sure the service looks like:
# app = "afk-apocalypse-signal"
# primary_region = "sea"   # pick one near you
#
# [http_service]
#   internal_port = 9000
#   force_https = true
#   auto_stop_machines = "off"   # keep it awake: a sleeping lobby misses joins
#   auto_start_machines = true
#   min_machines_running = 1
#   [http_service.concurrency]
#     type = "connections"
#     hard_limit = 500
#     soft_limit = 400
